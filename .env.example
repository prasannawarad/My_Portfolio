# Copy to `.env` (dev) and `.env.production` (build) and fill in.
# Both files are gitignored — only this template is tracked.

# Base URL of the Cloudflare Worker that serves the chat widget.
# No trailing slash; `/api/chat` is appended by src/utils/chatApi.js.
# Vite inlines this into the client bundle at build time, so it is public by
# design — never put a secret here. The Groq key lives only as a Wrangler
# secret on the Worker (`wrangler secret put GROQ_API_KEY`).
VITE_CHAT_API_URL=https://your-worker-name.your-subdomain.workers.dev
